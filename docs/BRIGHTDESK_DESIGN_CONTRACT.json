    "typography": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "hierarchy": "Clear page title, section title, body text and metadata; body copy remains readable at normal desktop scaling."
    },
    "shell": {
      "navigation": "Deep navy vertical navigation using the approved geometric Brightdesk mark and readable white/muted text.",
      "content": "Pale #F3F6FA workspace canvas with white working surfaces, subtle #DFE4EC borders and restrained shadows.",
      "productAccents": "Use the product-specific accent for active states, primary actions, focus indicators and product identity; do not recolour shared surfaces.",
      "icons": "Use original product SVG artwork. Never substitute emoji, Unicode symbols, initials or generic placeholders.",
      "controls": "Consistent button heights, spacing, radii, hover/pressed states and visible keyboard focus."
    },
    "accessibility": [
      "All actionable controls must be keyboard reachable and have visible focus.",
      "Use semantic labels, accessible names and a logical reading order.",
      "Maintain sufficient text contrast; never communicate state by colour alone.",
      "Respect reduced-motion preferences and adapt layouts without clipping essential actions."
    ],
    "evidence": {
      "conceptArtwork": "Concept artwork is a design reference, not a running-app screenshot.",
      "screenshots": "Only publish screenshots captured from the current running desktop build after its workflow has been checked. Keep them separate from concept previews."
    }
  },
