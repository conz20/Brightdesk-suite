#!/bin/bash
set -u

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
OWNER="conz20"

EXECUTABLE_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CONTENTS_DIR="$(cd "$EXECUTABLE_DIR/.." && pwd -P)"
APP_DIR="$(cd "$CONTENTS_DIR/.." && pwd -P)"
TOOLS_DIR="$(cd "$APP_DIR/.." && pwd -P)"
SETUP_SCRIPT="$TOOLS_DIR/Start-Brightdesk-Mac-Product-Runners.sh"

show_error() {
  /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with icon stop" >/dev/null 2>&1 || true
}

if [[ ! -f "$SETUP_SCRIPT" || -L "$SETUP_SCRIPT" ]]; then
  show_error "The runner setup script is missing or is a symbolic link. Keep the app beside the Brightdesk setup script and try again."
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  show_error "GitHub CLI is not installed or is not available in the standard Homebrew paths. Install GitHub CLI for the dedicated runner account. Do not sign in or save a GitHub credential in that account."
  exit 1
fi

choice="$(/usr/bin/osascript -e 'button returned of (display dialog "This setup requires a dedicated macOS runner user account with no personal GitHub login or saved credentials. It uses a temporary fine-grained token limited to the ten product repositories and clears it before starting runners. Continue to token entry?" buttons {"Cancel", "Continue"} default button "Continue" cancel button "Cancel" with icon caution)' 2>/dev/null)" || exit 0
[[ "$choice" == "Continue" ]] || exit 0

runner_token="$(/usr/bin/osascript -e 'text returned of (display dialog "Paste a temporary fine-grained token for conz20. It must select exactly the ten Brightdesk product repositories, have Administration: Read and write, and use the shortest expiry offered by GitHub. Revoke the token in GitHub Settings immediately after setup. Do not use a classic token or your normal saved GitHub login. The token is not written to the setup log and is cleared before any runner starts." default answer "" with hidden answer buttons {"Cancel", "Use Token"} default button "Use Token" cancel button "Cancel" with icon caution)' 2>/dev/null)" || exit 0
[[ -n "$runner_token" ]] || {
  show_error "No token was entered. No runners were registered."
  exit 1
}

LOG_DIR="$HOME/Library/Logs/Brightdesk/Product-Runner-Setup"
umask 077
mkdir -p "$LOG_DIR" || {
  show_error "The private setup log folder could not be created. No runners were registered."
  exit 1
}
chmod 700 "$LOG_DIR" || {
  show_error "The private setup log folder permissions could not be secured. No runners were registered."
  exit 1
}
LOG_FILE="$LOG_DIR/setup-$(date +%Y%m%d-%H%M%S).log"

if GH_TOKEN="$runner_token" BRIGHTDESK_RUNNER_SETUP_CONFIRMED=REGISTER /usr/bin/env PATH="$PATH" /bin/bash "$SETUP_SCRIPT" >"$LOG_FILE" 2>&1; then
  unset runner_token
  chmod 600 "$LOG_FILE" || true
  /usr/bin/osascript -e 'display dialog "The setup script finished. The temporary token was cleared before runner processes started. Open Settings > Actions > Runners in each product repository and confirm the runner is Idle/Online with the required labels. This does not mean queued tests have passed." buttons {"OK"} default button "OK" with icon note' >/dev/null 2>&1 || true
else
  unset runner_token
  chmod 600 "$LOG_FILE" || true
  show_error "Runner setup stopped before completing. No success is being reported. Check the private log in Library/Logs/Brightdesk/Product-Runner-Setup and do not share it without checking that it contains no sensitive information."
  exit 1
fi
