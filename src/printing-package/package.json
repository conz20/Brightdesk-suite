{
  "name": "@brightdesk/printing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared local-first printing adapter for Brightdesk desktop products",
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "build:macos-discovery": "bash tools/build-macos-printer-discovery.sh",
    "build:windows-discovery": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/build-windows-printer-discovery.ps1",
    "test": "node --test",
    "test:virtual-printer": "node --test test/virtual-printer-integration.test.mjs"
  },
  "main": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "types": "./index.d.ts"
}
