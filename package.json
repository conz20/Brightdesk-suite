{
  "name": "brightdesk-suite",
  "version": "1.0.0",
  "description": "Brightdesk Office Suite — 10 applications with a shared design system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces dev --if-present",
    "build": "npm run --workspaces build --if-present",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "author": "Connor Molloy",
  "license": "MIT"
}
