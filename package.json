{
  "name": "brightdesk-suite",
  "version": "0.1.0",
  "description": "Brightdesk — an independent desktop productivity suite for documents, spreadsheets, presentations and notes, with protected multilingual spelling resources",
  "main": "src/main.js",
  "author": {
    "name": "Brightdesk Community",
    "email": "noreply@github.com"
  },
  "license": "MIT",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "check:node": "node scripts/check-node24.js",
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run verify:licenses && electron-builder --publish never",
    "dist:win": "npm run verify:licenses && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run verify:licenses && electron-builder --mac dmg pkg zip --universal --publish never",
    "dist:linux": "npm run verify:licenses && electron-builder --linux AppImage deb --x64 --publish never",
    "release": "npm run verify:licenses && electron-builder --publish always",
    "verify:licenses": "node scripts/verify-licenses.js",
    "postinstall": "npm run verify:licenses",
    "dist:apps:win": "npm run verify:licenses && node scripts/build-apps.js win",
    "dist:apps:mac": "npm run verify:licenses && node scripts/build-apps.js mac",
    "dist:apps:linux": "npm run verify:licenses && node scripts/build-apps.js linux",
    "dist:pages:win": "node scripts/build-app.js pages win",
    "dist:pages:mac": "node scripts/build-app.js pages mac",
    "dist:pages:linux": "node scripts/build-app.js pages linux",
    "dist:sheets:win": "node scripts/build-app.js sheets win",
    "dist:sheets:mac": "node scripts/build-app.js sheets mac",
    "dist:sheets:linux": "node scripts/build-app.js sheets linux",
    "dist:decks:win": "node scripts/build-app.js slides win",
    "dist:decks:mac": "node scripts/build-app.js slides mac",
    "dist:decks:linux": "node scripts/build-app.js slides linux",
    "dist:notes:win": "node scripts/build-app.js notes win",
    "dist:notes:mac": "node scripts/build-app.js notes mac",
    "dist:notes:linux": "node scripts/build-app.js notes linux",
    "rea:inspect": "node scripts/brightdesk-rea.js inspect",
    "fix:app-js": "node scripts/fix-app-js.js",
    "release:preflight": "node scripts/release-preflight.js",
    "release:verify:win": "node scripts/verify-release-artifacts.js win",
    "release:verify:mac": "node scripts/verify-release-artifacts.js mac",
    "release:verify:linux": "node scripts/verify-release-artifacts.js linux",
    "release:prepare": "node scripts/prepare-release-assets.js",
    "lock:prepare": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "lock:verify": "node scripts/verify-lockfile.js",
    "setup:dev": "node scripts/setup/bootstrap-dev.js",
    "dist:app": "npm run verify:licenses && node scripts/build-app.js",
    "release:apps:win": "npm run verify:licenses && node scripts/build-apps.js win always",
    "release:apps:mac": "npm run verify:licenses && node scripts/build-apps.js mac always",
    "release:apps:linux": "npm run verify:licenses && node scripts/build-apps.js linux always"
  },
  "dependencies": {
    "docx": "9.15.1",
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "mammoth": "1.12.2",
    "nspell": "2.1.5",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "build": {
    "appId": "org.brightdesk.suite",
    "productName": "Brightdesk",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "TERMS_AND_CONDITIONS.txt"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets/branding"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "connormolloy12",
        "repo": "Brightdesk-suite"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Brightdesk-Setup-${version}-${arch}.${ext}",
      "icon": "brightdesk-suite-mark.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "TERMS_AND_CONDITIONS.txt"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Brightdesk-${version}-${arch}.${ext}",
      "icon": "brightdesk-suite-mark.svg"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "brightdesk-${version}-${arch}.${ext}",
      "icon": "brightdesk-suite-mark.svg"
    },
    "appImage": {
      "artifactName": "Brightdesk-${version}-${arch}.${ext}"
    },
    "pkg": {
      "license": "TERMS_AND_CONDITIONS.txt",
      "welcome": "installer/mac-welcome.txt",
      "conclusion": "installer/mac-conclusion.txt",
      "installLocation": "/Applications"
    }
  }
}
