    "predist:sheets:win": "npm run build:native",
    "predist:sheets:mac": "npm run build:native",
    "predist:sheets:linux": "npm run build:native",
    "predist:decks:win": "npm run build:native",
    "predist:decks:mac": "npm run build:native",
    "predist:decks:linux": "npm run build:native",
    "predist:notes:win": "npm run build:native",
    "predist:notes:mac": "npm run build:native",
    "predist:notes:linux": "npm run build:native",
    "predist:database:win": "npm run build:native",
    "predist:database:mac": "npm run build:native",
    "predist:database:linux": "npm run build:native",
    "predist:forms:win": "npm run build:native",
    "predist:forms:mac": "npm run build:native",
    "predist:forms:linux": "npm run build:native",
    "predist:lists:win": "npm run build:native",
    "predist:lists:mac": "npm run build:native",
    "predist:lists:linux": "npm run build:native",
    "predist:planner:win": "npm run build:native",
    "predist:planner:mac": "npm run build:native",
    "predist:planner:linux": "npm run build:native",
    "predist:todo:win": "npm run build:native",
    "predist:todo:mac": "npm run build:native",
    "predist:todo:linux": "npm run build:native",
    "predist:workspace:win": "npm run build:native",
    "predist:workspace:mac": "npm run build:native",
    "predist:workspace:linux": "npm run build:native",
    "predist:products:win": "npm run build:native",
    "predist:products:mac": "npm run build:native",
    "predist:products:linux": "npm run build:native",
    "dist:product:win": "node scripts/build-app.js loop win",
    "dist:product:mac": "node scripts/build-app.js loop mac",
    "dist:product:linux": "node scripts/build-app.js loop linux",
    "prestart": "npm run build:native",
    "predist:product:win": "npm run build:native",
    "predist:product:mac": "npm run build:native",
    "predist:product:linux": "npm run build:native",
    "verify:product:win": "node scripts/verify-standalone-apps.js win release/apps loop",
    "verify:product:mac": "node scripts/verify-standalone-apps.js mac release/apps loop",
