    "dist:products:linux": "node scripts/build-apps.js linux",
    "release:verify:products:win": "node scripts/verify-standalone-apps.js win",
    "release:verify:products:mac": "node scripts/verify-standalone-apps.js mac",
    "release:verify:products:linux": "node scripts/verify-standalone-apps.js linux",
    "build:native": "node scripts/build-native.js",
    "predist": "npm run build:native",
    "predist:win": "npm run build:native",
    "predist:mac": "npm run build:native",
    "predist:linux": "npm run build:native",
    "prerelease": "npm run build:native",
    "predist:apps:win": "npm run build:native",
    "predist:apps:mac": "npm run build:native",
    "predist:apps:linux": "npm run build:native",
    "predist:pages:win": "npm run build:native",
    "predist:pages:mac": "npm run build:native",
