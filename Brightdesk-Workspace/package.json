  "scripts": {
    "check:node": "node scripts/check-node24.js",
    "start": "electron .",
    "test": "node --test tests/app-repository-seeds.test.js tests/database-service.test.js tests/database-ui-integration.test.js tests/dictionary-service.test.js tests/file-service.test.js tests/forms-service.test.js tests/forms-ui-integration.test.js tests/formula.test.js tests/installer-agreement.test.js tests/integrated-app-shell.test.js tests/language-service.test.js tests/license-verification.test.js tests/lists-service.test.js tests/lists-ui-integration.test.js tests/node-runtime-setup.test.js tests/page-layout.test.js tests/planner-service.test.js tests/planner-ui-integration.test.js tests/rea-bench.test.js tests/release-readiness.test.js tests/resource-protection.test.js tests/standalone-downloads.test.js tests/standalone-pages.test.js tests/todo-service.test.js tests/todo-ui-integration.test.js tests/update-settings.test.js tests/workspace-service.test.js tests/workspace-ui-integration.test.js",
    "dist": "npm run verify:licenses && electron-builder --publish never",
    "dist:win": "npm run verify:licenses && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run verify:licenses && electron-builder --mac dmg pkg zip --universal --publish never",
    "dist:linux": "npm run verify:licenses && electron-builder --linux AppImage deb --x64 --publish never",
    "release": "npm run verify:licenses && electron-builder --publish always",
    "verify:licenses": "node scripts/verify-licenses.js",
    "postinstall": "npm run verify:licenses",
    "dist:apps:win": "node scripts/build-apps.js win",
    "dist:apps:mac": "node scripts/build-apps.js mac",
    "dist:apps:linux": "node scripts/build-apps.js linux",
