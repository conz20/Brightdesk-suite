    "dist:planner:mac": "node scripts/build-app.js planner mac",
    "dist:planner:linux": "node scripts/build-app.js planner linux",
    "dist:todo:win": "node scripts/build-app.js todo win",
    "dist:todo:mac": "node scripts/build-app.js todo mac",
    "dist:todo:linux": "node scripts/build-app.js todo linux",
    "dist:workspace:win": "node scripts/build-app.js loop win",
    "dist:workspace:mac": "node scripts/build-app.js loop mac",
    "dist:workspace:linux": "node scripts/build-app.js loop linux",
