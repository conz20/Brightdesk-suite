  "dependencies": {
    "docx": "9.15.1",
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "nspell": "2.1.5",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "build": {
    "appId": "org.brightdesk.loop",
    "productName": "Brightdesk Workspace",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "TERMS_AND_CONDITIONS.txt",
      "native/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets/branding"
    },
    "publish": [],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Brightdesk-Setup-${version}-${arch}.${ext}",
      "icon": "brightdesk-suite-mark.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "TERMS_AND_CONDITIONS.txt"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Brightdesk-${version}-${arch}.${ext}",
      "icon": "brightdesk-suite-mark.svg"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "brightdesk-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "icon": "brightdesk-suite-mark.svg"
    },
    "appImage": {
      "artifactName": "Brightdesk-${version}-${arch}.${ext}"
    },
    "pkg": {
      "license": "TERMS_AND_CONDITIONS.txt",
      "welcome": "installer/mac-welcome.txt",
      "conclusion": "installer/mac-conclusion.txt",
      "installLocation": "/Applications"
    },
    "asarUnpack": [
      "native/**/*.node"
    ]
  },
  "desktopName": "org.brightdesk.suite.desktop",
  "brightdeskAppId": "loop"
}
